# /etc/nginx/sites-available/elleyhillzm.com

# 1. HTTP - Redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name elleyhillzm.com www.elleyhillzm.com;
    return 301 https://$host$request_uri;
}

# 2. HTTPS - Next.js Reverse Proxy
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name elleyhillzm.com www.elleyhillzm.com;

    # SSL Certificates (managed automatically by Certbot)
    # ssl_certificate /etc/letsencrypt/live/elleyhillzm.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/elleyhillzm.com/privkey.pem;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip Compression
    gzip on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Static Assets Caching (_next/static)
    location /_next/static/ {
        alias /var/www/elleyhill-site/.next/static/;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Public static files (images, icons, etc.)
    location /static/ {
        alias /var/www/elleyhill-site/public/;
        expires 30d;
        access_log off;
    }

    # Main Application Proxy
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
        proxy_connect_timeout 60s;
    }
}
