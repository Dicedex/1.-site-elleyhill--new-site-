{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elleyhill-pawapay-gateway",
  "main": "src/index.js",
  "compatibility_date": "2024-09-22",
  "vars": {
    "PAWAPAY_ENV": "sandbox",
    "ALLOWED_ORIGIN": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elleyhill-power-d1",
      "database_id": "747653b2-c912-473b-a39d-236d909d67fc"
    },
    {
      "binding": "elleyhill_power_d1",
      "database_name": "elleyhill-power-d1",
      "database_id": "747653b2-c912-473b-a39d-236d909d67fc"
    }
  ]
}
